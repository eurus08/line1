# Doxyfile for line1 (Phase 7, step 7.2)
#
# Generates browsable HTML API documentation from the Doxygen-tagged
# comments in include/line1/*.h and include/line1/mpi/*.h.
#
# This is a curated subset of Doxygen's full configuration -- any
# setting not listed here uses Doxygen's own default (run
# `doxygen -g -` to see the full default file with all ~280 options
# and their built-in values). Keeping this file short means it only
# needs updating when a setting actually needs to differ from the
# sensible default, rather than carrying ~2800 lines of mostly-unused
# boilerplate.
#
# Usage:
#   doxygen Doxyfile
#   open docs/html/index.html
#
# Requires: doxygen. Graphviz is NOT required -- HAVE_DOT is off
# below, so call graphs are skipped in favour of keeping the doc
# build dependency-free beyond Doxygen itself.

#---------------------------------------------------------------------------
# Project identity
#---------------------------------------------------------------------------
PROJECT_NAME           = "line1"
PROJECT_BRIEF           = "A production-quality BLAS Level 1 library in C -- serial and MPI-parallel"
PROJECT_NUMBER          = 1.0.0
OUTPUT_LANGUAGE         = English

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
# Only the public headers are documented -- src/ and kernel/ are
# implementation detail, not the library's API surface. README.md is
# included so it becomes the generated site's front page (see
# USE_MDFILE_AS_MAINPAGE below).
INPUT                   = README.md include/line1
RECURSIVE               = YES
FILE_PATTERNS           = *.h
USE_MDFILE_AS_MAINPAGE  = README.md

#---------------------------------------------------------------------------
# Output
#---------------------------------------------------------------------------
OUTPUT_DIRECTORY        = docs
GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_LATEX          = NO
GENERATE_TREEVIEW       = YES

#---------------------------------------------------------------------------
# What to extract
#---------------------------------------------------------------------------
# EXTRACT_ALL is deliberately OFF: every public function, struct, and
# macro in include/ already has a real Doxygen comment (this was
# step 7.2's whole point), so turning EXTRACT_ALL on would only ever
# paper over a genuinely undocumented symbol rather than catch it --
# the WARN_IF_UNDOCUMENTED setting below is what should catch that.
EXTRACT_ALL             = NO
EXTRACT_STATIC          = NO
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO

#---------------------------------------------------------------------------
# Warnings -- matches the project's zero-warnings discipline elsewhere
#---------------------------------------------------------------------------
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_NO_PARAMDOC        = YES
WARN_AS_ERROR           = NO

#---------------------------------------------------------------------------
# Formatting
#---------------------------------------------------------------------------
# Doxygen's Markdown support renders the @f[ ... @f] LaTeX-style math
# blocks in the headers via MathJax in the generated HTML -- no local
# LaTeX/dvipng installation needed.
MARKDOWN_SUPPORT        = YES
USE_MATHJAX             = YES
TAB_SIZE                = 4

#---------------------------------------------------------------------------
# Diagrams -- off by default, see file header comment above
#---------------------------------------------------------------------------
HAVE_DOT                = NO

#---------------------------------------------------------------------------
# Misc
#---------------------------------------------------------------------------
QUIET                   = YES
SOURCE_BROWSER          = NO
GENERATE_TODOLIST       = YES
GENERATE_BUGLIST        = YES
