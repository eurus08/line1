# blas1-mpi.pc.in — template for the MPI layer's separate pkg-config
# file. blas1_mpi is an optional, separately-built static library
# (only exists when BLAS1_BUILD_MPI=ON), so it gets its own .pc
# rather than being folded into blas1.pc -- a consumer who only wants
# the serial library shouldn't have MPI's compile/link flags forced
# into their build by depending on "blas1" alone.
#
# `Requires: blas1` tells pkg-config to also pull in blas1.pc's own
# Cflags/Libs automatically -- blas1_mpi is a thin wrapper around the
# serial library's functions, so anything linking blas1_mpi needs
# blas1 too. The Cflags/Libs lines below carry this machine's actual
# MPI include/link flags, captured from find_package(MPI) at
# configure time -- see the install() block in this directory's
# CMakeLists.txt for how they're built.
#
#   pkg-config --cflags --libs blas1-mpi

prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: blas1-mpi
Description: MPI-parallel layer for @PROJECT_NAME@
Version: @PROJECT_VERSION@
Requires: blas1
Libs: -L${libdir} -lblas1_mpi @BLAS1_MPI_PC_LIBS@
Cflags: -I${includedir} @BLAS1_MPI_PC_CFLAGS@
